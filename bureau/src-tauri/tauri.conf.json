{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Belai Bureau",
  "version": "0.2.0",
  "identifier": "garden.belai.bureau",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "Belai's Flowers",
    "shortDescription": "Bouquets vivants sur le bureau",
    "longDescription": "Pose les bouquets animés de Belai's Flowers sur ton fond d'écran, où tu veux, à la taille que tu veux.",
    "category": "Lifestyle",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "French"
        ]
      }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "belai"
        ]
      }
    }
  }
}
